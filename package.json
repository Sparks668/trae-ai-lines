{
  "name": "trae-ai-lines",
  "displayName": "Trae AI Lines",
  "description": "统计 Trae 的 AI 编码行数，并在 Git 提交时校验 AI 占比。",
  "version": "0.2.46",
  "icon": "icon.png",
  "publisher": "bobchen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sparks668/trae-ai-lines.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiLines.refresh",
        "title": "Trae AI Lines: Refresh"
      },
      {
        "command": "aiLines.diagnose",
        "title": "Trae AI Lines: Diagnose"
      },
      {
        "command": "aiLines.showDetails",
        "title": "Trae AI Lines: Show Details"
      },
      {
        "command": "aiLines.guardToggle",
        "title": "AI-GIT: Toggle"
      },
      {
        "command": "aiLines.guardEnableAll",
        "title": "AI-GIT: Enable All Workspace Repositories"
      },
      {
        "command": "aiLines.guardSetThreshold",
        "title": "AI-GIT: Set Threshold"
      },
      {
        "command": "aiLines.guardToggleImport",
        "title": "AI-GIT: Toggle Import Guard"
      }
    ]
  }
}
